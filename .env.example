# Local development defaults (match docker-compose.yml).
# Production values (Neon DATABASE_URL, real UA) live in GitHub Actions / Vercel secrets.
DATABASE_URL=postgres://cdlhub:cdlhub@localhost:54329/cdlhub

# Required by Liquipedia ToS for any LPDB request. The contact address is not
# optional — an unidentified client is the one they block.
# CDLHUB_UA="cdlhub/0.1 (https://github.com/WillTufff/COD-DataAnalysis; <contact-email>)"
# LPDB_API_KEY=

# CDL-era box scores (2020-2026). Paced under the tier's limits; responses are
# snapshotted locally and never redistributed.
# CITO_API_KEY=
